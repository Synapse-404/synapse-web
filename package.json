{
  "name": "synapse-web",
  "author": "Carlos Stiwar Asprilla Mosquera",
  "description": "Sitio web oficial del semillero de investigación SYNAPSE.",
  "keywords": [
    "synapse",
    "semillero",
    "investigación",
    "uniclaretiana",
    "quibdó",
    "chocó",
    "colombia"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Synapse-404"
  },
  "license": "MIT",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm run db:generate && pnpm run validate:team && pnpm run vercel:bootstrap && next build",
    "validate:team": "node scripts/validate-team.mjs",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "admin:create": "tsx scripts/create-admin.ts",
    "test:admissions": "node --experimental-strip-types --test tests/admissions.test.mjs",
    "test:tracking": "node --experimental-strip-types --test tests/tracking.test.mjs",
    "vercel-build": "pnpm run build",
    "vercel:bootstrap": "node scripts/prepare-vercel.mjs",
    "test:deployment": "node --test tests/vercel-bootstrap.test.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@vercel/speed-insights": "^2.0.0",
    "autoprefixer": "^10.5.0",
    "dotenv": "^18.0.6",
    "next": "16.2.7",
    "pg": "^8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
